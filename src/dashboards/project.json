{
  "revision": 1,
  "uid": "dt-project",
  "title": "Dependency-Track / Project",
  "tags": ["dependency-track"],
  "editable": true,
  "schemaVersion": 41,
  "time": { "from": "now-90d", "to": "now" },
  "refresh": "",
  "links": [
    {
      "title": "Dependency-Track",
      "type": "dashboards",
      "tags": ["dependency-track"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "windkube-dependencytrack-datasource",
        "current": {}
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
        "query": { "refId": "project", "type": "projects", "onlyLatest": true },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "builtIn": 1,
        "type": "dashboard",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      },
      {
        "name": "Dependency-Track events",
        "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "refId": "Anno",
          "queryType": "events",
          "projects": { "mode": "name", "nameRegex": "^$project$", "onlyLatest": true },
          "events": { "kinds": ["bomImport", "finding", "violation"] }
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Vulnerabilities",
      "description": "Latest version of the project.",
      "gridPos": { "x": 0, "y": 0, "w": 15, "h": 5 },
      "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "projectMetrics",
          "mode": "current",
          "metrics": ["critical", "high", "medium", "low", "unassigned"],
          "projects": { "mode": "name", "nameRegex": "^$project$", "onlyLatest": true }
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* Critical$" },
            "properties": [
              { "id": "displayName", "value": "Critical" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* High$" },
            "properties": [
              { "id": "displayName", "value": "High" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* Medium$" },
            "properties": [
              { "id": "displayName", "value": "Medium" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* Low$" },
            "properties": [
              { "id": "displayName", "value": "Low" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* Unassigned$" },
            "properties": [{ "id": "displayName", "value": "Unassigned" }]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Policy violations",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 5 },
      "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "projectMetrics",
          "mode": "current",
          "metrics": ["policyViolationsFail", "policyViolationsWarn", "policyViolationsInfo"],
          "projects": { "mode": "name", "nameRegex": "^$project$", "onlyLatest": true }
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(fail\\)$" },
            "properties": [
              { "id": "displayName", "value": "Fail" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(warn\\)$" },
            "properties": [
              { "id": "displayName", "value": "Warn" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".*\\(info\\)$" },
            "properties": [{ "id": "displayName", "value": "Info" }]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Vulnerabilities over time",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "projectMetrics",
          "mode": "timeseries",
          "metrics": ["critical", "high", "medium", "low"],
          "projects": { "mode": "name", "nameRegex": "^$project$", "onlyLatest": true }
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* Critical$" },
            "properties": [
              { "id": "displayName", "value": "Critical" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* High$" },
            "properties": [
              { "id": "displayName", "value": "High" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* Medium$" },
            "properties": [
              { "id": "displayName", "value": "Medium" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": ".* Low$" },
            "properties": [
              { "id": "displayName", "value": "Low" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Findings",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 9 },
      "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "findings",
          "format": "table",
          "projects": { "mode": "name", "nameRegex": "^$project$", "onlyLatest": true }
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "CVSS", "desc": true }] },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Project": true, "Version": true, "Tags": true, "PURL": true, "Attributed": true }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* UUID$" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Severity" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "CRITICAL": { "color": "dark-red", "index": 0 },
                      "HIGH": { "color": "orange", "index": 1 },
                      "MEDIUM": { "color": "yellow", "index": 2 },
                      "LOW": { "color": "blue", "index": 3 }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "EPSS" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Policy violations",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 7 },
      "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "violations",
          "format": "table",
          "projects": { "mode": "name", "nameRegex": "^$project$", "onlyLatest": true }
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "transformations": [
        {
          "id": "organize",
          "options": { "excludeByName": { "Project": true, "Version": true, "Tags": true, "PURL": true } }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* UUID$" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "State" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": { "FAIL": { "color": "red", "index": 0 }, "WARN": { "color": "orange", "index": 1 } }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Versions",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 6 },
      "datasource": { "type": "windkube-dependencytrack-datasource", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "queryType": "projects",
          "format": "table",
          "projects": { "mode": "name", "nameRegex": "^$project$", "includeInactive": true }
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Project": true, "Tags": true, "Classifier": true } } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* UUID$" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "BOM age" },
            "properties": [
              {
                "id": "mappings",
                "value": [{ "type": "special", "options": { "match": "null", "result": { "text": "Never" } } }]
              }
            ]
          }
        ]
      }
    }
  ]
}
